#!/usr/bin/env bash
set -euo pipefail

# Update a Homebrew formula's version and sha256 from a curlew release.
# Reuses the checksum the release workflow already published, so the formula
# pins exactly the bytes users verify rather than a recomputed hash.
#
# Required env:
#   FORMULA  formula name, e.g. curlew
#   VERSION  release tag WITH the leading v, e.g. v0.2.0

: "${VERSION:?Must specify version}"
: "${FORMULA:?Must specify formula}"

formula_file="Formula/$FORMULA.rb"
[[ -f "$formula_file" ]] || { echo "Error: $formula_file not found" >&2; exit 1; }

shasum=$(
  curl -fsSL "https://github.com/ketsugi/$FORMULA/releases/download/$VERSION/$FORMULA.sha256" \
    | awk '{ print $1 }'
)
[[ "$shasum" =~ ^[0-9a-f]{64}$ ]] || { echo "Error: invalid checksum: '$shasum'" >&2; exit 1; }

# GitHub runners are Linux; GNU sed -i is all we need.
# version field is the tag without the leading v; url interpolates v#{version}.
sed -i "s/version \".*\"/version \"${VERSION#v}\"/" "$formula_file"
sed -i "s/sha256 \".*\"/sha256 \"$shasum\"/" "$formula_file"

echo "Updated $formula_file to ${VERSION#v} ($shasum)"
